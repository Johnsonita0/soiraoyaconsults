{
  "devCommand": "npm run dev:vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter/cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/maintenance/visitor-cleanup",
      "schedule": "10 0 * * *"
    }
  ]
}
